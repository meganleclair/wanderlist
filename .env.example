# Wanderlist Environment Variables
# Copy this file to .env and fill in your values

# Geoapify API Key (server-side only)
# Get yours at https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Supabase Configuration (client-side safe)
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Unsplash API Key (server-side only)
# Get yours at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
